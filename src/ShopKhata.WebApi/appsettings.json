{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ShopKhata": "Server=(localdb)\\MSSQLLocalDB;Database=ShopKhataDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "ShopKhata",
    "Audience": "ShopKhata.Client",
    "LifetimeMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Seed": {
    "Enabled": false,
    "AllowAdditionalOwner": false
  },
  "AllowedHosts": "*"
}
